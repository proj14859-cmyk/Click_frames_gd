{
  "geode": "5.10.1",
  "gd": { "win": "2.2081", "android": "2.2081" },
  "id": "juan.click_frames_gd",
  "name": "Click Frames GD",
  "version": "v0.1.1",
  "developer": "Juan",
  "description": "Practice recording, verified timing windows and replay showcases at 240 TPS.",
  "resources": { "files": ["resources/*.wav"] },
  "settings": {
    "sounds": { "type": "bool", "name": "Click sounds", "default": true },
    "scan-radius": { "type": "int", "name": "Search radius (ticks)", "default": 12, "min": 1, "max": 60 },
    "counter-scale": { "type": "float", "name": "Counter size", "default": 1.0, "min": 0.5, "max": 2.0 },
    "marker-scale": { "type": "float", "name": "Marker size", "default": 1.0, "min": 0.5, "max": 2.0 }
  }
}
